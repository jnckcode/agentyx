{
  "name": "agentyx",
  "version": "3.2.6",
  "description": "Platform Agentic AI CLI Global with 9router integration, SQLite Second Brain, and Reasoning Mitigation Engine",
  "type": "module",
  "bin": {
    "agentyx": "./bin/agentyx.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "link-global": "npm link",
    "unlink-global": "npm unlink agentyx",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jnckcode/agentyx.git"
  },
  "homepage": "https://github.com/jnckcode/agentyx#readme",
  "keywords": [
    "cli",
    "agentic-ai",
    "agentyx",
    "9router",
    "sqlite",
    "second-brain",
    "mcp"
  ],
  "author": "jnckcode",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "dotenv": "^16.6.1",
    "glob": "^11.1.0",
    "inquirer": "^12.11.1",
    "node-fetch": "^3.3.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
